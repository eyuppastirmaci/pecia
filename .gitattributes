# Bundled SQL migrations keep LF on every checkout so each platform packages identical resources.
*.sql text eol=lf

# Preserve the exact bytes of the checksum-verified upstream vocabulary.
pecia-core/src/main/resources/dev/eyuppastirmaci/pecia/tokenization/all-MiniLM-L6-v2/vocab.txt -text

# Golden inputs and expectations must retain their reviewed bytes, including CRLF and missing final newlines.
pecia-core/src/test/resources/chunking/golden/** -text
# Whitespace is intentional test data in inputs, including blank-only files and CRLF terminators.
pecia-core/src/test/resources/chunking/golden/**/*.input whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Hostile inputs must retain their exact bytes, including invalid encodings, CR terminators and deliberate whitespace.
pecia-core/src/test/resources/hostile/** -text
pecia-core/src/test/resources/hostile/content/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Legacy index fixtures are the exact binary output of earlier code and must never be converted or merged.
pecia-core/src/test/resources/storage/legacy/*.db binary

# Gradle wrapper scripts keep the line endings their shells require, and the wrapper JAR is never converted.
gradlew text eol=lf
gradlew.bat text eol=crlf
gradle/wrapper/gradle-wrapper.jar binary

# ONNX models are binary test fixtures.
*.onnx binary
